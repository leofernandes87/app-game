<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="appPU" transaction-type="JTA">
        <!-- JNDI do DataSource criado no WildFly -->
        <jta-data-source>java:/jdbc/PostgresDS</jta-data-source>

        <properties>
            <!-- Dialeto do Hibernate p/ Postgres -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- DEV: geração de schema; ajuste como preferir -->
            <!-- none | validate | update | create | create-drop -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>

            <!-- Logs SQL (opcional em DEV) -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>

            <!-- (Opcional) defina o schema padrão, se você criou um schema específico -->
            <!-- <property name="hibernate.default_schema" value="public"/> -->

            <!-- (Opcional) timezone coerente -->
            <!-- <property name="hibernate.jdbc.time_zone" value="UTC"/> -->
        </properties>
    </persistence-unit>
</persistence>
